pipeline {

    agent none

    options {
        skipDefaultCheckout(true)
    }

    environment {
        DOCKER_IMAGE = 'agrifarm1.2-app'
        DOCKER_CONTAINER = 'agrifarm-container'
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['testing','prod'],
            description: 'Environment name'
        )
    }

    stages {

        stage('git clone') {

            agent any

            steps {

                git branch: 'dev',
                    url: 'https://github.com/SWATHI2129/agrifarm.git'
            }
        }

        stage('list command') {

            agent any

            steps {

                bat 'dir'
            }
        }

        stage('maven test stage') {

            when {
                expression {
                    params.ENVIRONMENT == "testing"
                }
            }

            agent {
                label 'maven-agent'
            }

            steps {

                bat 'mvn test'
            }
        }

        stage('maven build stage') {

            agent {
                label 'maven-agent'
            }

            steps {

                bat 'mvn clean install -DskipTests=true'
            }
        }

        stage('Docker Compose Down') {

            agent any

            steps {

                bat 'docker compose down'
            }
        }

        stage('Docker Compose Build & Up') {

            agent any

            steps {

                bat 'docker compose up -d --build'
            }
        }

        stage('Docker Verify') {

            agent any

            steps {

                bat 'docker ps'
            }
        }
    }
}
